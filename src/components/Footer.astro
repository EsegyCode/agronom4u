---
import { FOOTER_COLUMNS, SITE } from '../data/site';
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <a href="/index.html" aria-label={SITE.name} style="display:inline-block;margin-bottom:14px;">
          <img src="/logo-dark.svg" alt="Agronom4u — Агроном для тебе" width="220" height="48" />
        </a>
        <p style="margin:0 0 14px;color:var(--text-on-dark-muted);font-size:0.92rem;max-width:34ch;">
          Практична база знань з вирощування польових і городніх культур України: реальні технологічні карти, сівозміна та економіка 1 га.
        </p>
        <span class="badge badge-dark">🇺🇦 Адаптовано для України</span>
      </div>

      {FOOTER_COLUMNS.map((col) => (
        <div class="footer-col">
          <h4>{col.title}</h4>
          <ul>
            {col.links.map((link) => (
              <li><a href={link.href}>{link.label}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="footer-bottom">
      <span>© {new Date().getFullYear()} {SITE.name} ({SITE.shortName}) — Україна</span>
      <span>Створено на Astro • <a href="/sitemap-index.xml" style="color:var(--light-green);">Sitemap</a> • <a href="/llms.txt" style="color:var(--light-green);">llms.txt</a></span>
    </div>
  </div>
</footer>
