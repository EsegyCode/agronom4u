---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import {
  FIELD_CROPS,
  FIELD_TOPICS,
  type FieldCrop,
  type TopicMeta,
} from '../../../../data/fieldCrops';
import { SITE } from '../../../../data/site';

export function getStaticPaths() {
  const paths: {
    params: { crop: string; topic: string };
    props: {
      crop: FieldCrop;
      topicMeta: TopicMeta;
      prevTopic: TopicMeta | null;
      nextTopic: TopicMeta | null;
    };
  }[] = [];

  for (const crop of Object.values(FIELD_CROPS)) {
    FIELD_TOPICS.forEach((topicMeta, idx) => {
      paths.push({
        params: { crop: crop.slug, topic: topicMeta.slug },
        props: {
          crop,
          topicMeta,
          prevTopic: idx > 0 ? FIELD_TOPICS[idx - 1] : null,
          nextTopic: idx < FIELD_TOPICS.length - 1 ? FIELD_TOPICS[idx + 1] : null,
        },
      });
    });
  }

  return paths;
}

interface Props {
  crop: FieldCrop;
  topicMeta: TopicMeta;
  prevTopic: TopicMeta | null;
  nextTopic: TopicMeta | null;
}

const { crop, topicMeta, prevTopic, nextTopic } = Astro.props;
const content = crop.topics[topicMeta.slug];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: `${crop.name} — ${topicMeta.title}`,
    description: content.summary,
    inLanguage: 'uk',
    mainEntityOfPage: `${SITE.url}/crops/field/${crop.slug}/${topicMeta.slug}.html`,
    author: { '@type': 'Organization', name: SITE.name },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Головна', item: `${SITE.url}/index.html` },
      { '@type': 'ListItem', position: 2, name: 'Польові культури', item: `${SITE.url}/crops/field/index.html` },
      { '@type': 'ListItem', position: 3, name: crop.name, item: `${SITE.url}/crops/field/${crop.slug}/index.html` },
      { '@type': 'ListItem', position: 4, name: topicMeta.title, item: `${SITE.url}/crops/field/${crop.slug}/${topicMeta.slug}.html` },
    ],
  },
];
---

<BaseLayout
  title={`${crop.name} — ${topicMeta.title}`}
  description={content.summary}
  ogImage={`/og/field-${crop.slug}.png`}
  canonicalPath={`/crops/field/${crop.slug}/${topicMeta.slug}.html`}
  schema={schema}
>
  <section class="page-hero">
    <div class="container">
      <div class="breadcrumbs">
        <a href="/index.html">Головна</a> ›
        <a href="/crops/field/index.html">Польові культури</a> ›
        <a href={`/crops/field/${crop.slug}/index.html`}>{crop.name}</a> ›
        <span>{topicMeta.title}</span>
      </div>
      <span class="badge badge-dark">{topicMeta.icon} Етап {topicMeta.order} із {FIELD_TOPICS.length}</span>
      <h1>{crop.name}: {topicMeta.title}</h1>
      <p>{content.summary}</p>
    </div>
  </section>

  <section class="section section-white">
    <div class="container" style="display: grid; grid-template-columns: 1fr 310px; gap: 32px; align-items: start;">
      <div style="display: flex; flex-direction: column; gap: 24px;">
        <!-- Key Metrics -->
        <div class="grid cols-3" style="gap: 12px;">
          {content.keyMetrics.map((m) => (
            <div style="background: var(--surface-soft); border: 1px solid var(--border); border-radius: 12px; padding: 14px;">
              <div style="font-size: 0.78rem; color: var(--text-muted); font-weight: 600;">{m.label}</div>
              <div style="font-size: 1.02rem; font-weight: 800; color: var(--dark-green); margin-top: 4px;">{m.value}</div>
            </div>
          ))}
        </div>

        <!-- Steps -->
        <div class="card" style="padding: 24px;">
          <h2 style="margin: 0 0 14px; font-size: 1.25rem; color: var(--dark-green);">Практичні кроки та рекомендації</h2>
          <ol style="margin: 0; padding-left: 20px; display: flex; flex-direction: column; gap: 10px;">
            {content.steps.map((step) => (
              <li style="color: var(--text);">{step}</li>
            ))}
          </ol>
        </div>

        <!-- Notes -->
        {content.notes.length > 0 && (
          <div style="background: var(--surface-mint); border-left: 4px solid var(--green); border-radius: 12px; padding: 18px 20px;">
            <strong style="display: block; color: var(--dark-green); margin-bottom: 6px;">📌 Агрономічна примітка</strong>
            {content.notes.map((n) => (
              <p style="margin: 0; color: var(--text); font-size: 0.95rem;">{n}</p>
            ))}
          </div>
        )}

        <!-- Prev / Next Navigation -->
        <div style="display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; padding-top: 12px; border-top: 1px solid var(--border);">
          {prevTopic ? (
            <a class="btn btn-outline" href={`/crops/field/${crop.slug}/${prevTopic.slug}.html`}>
              ← {prevTopic.order}. {prevTopic.title}
            </a>
          ) : (
            <a class="btn btn-outline" href={`/crops/field/${crop.slug}/index.html`}>
              ← До путівника: {crop.name}
            </a>
          )}
          {nextTopic && (
            <a class="btn btn-primary" href={`/crops/field/${crop.slug}/${nextTopic.slug}.html`}>
              {nextTopic.order}. {nextTopic.title} →
            </a>
          )}
        </div>
      </div>

      <!-- Sidebar TOC -->
      <aside class="card" style="padding: 18px; position: sticky; top: 88px;">
        <h3 style="margin: 0 0 12px; font-size: 1rem; color: var(--dark-green);">Розділи: {crop.name}</h3>
        <ul style="list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 4px;">
          {FIELD_TOPICS.map((t) => {
            const current = t.slug === topicMeta.slug;
            return (
              <li>
                <a
                  href={`/crops/field/${crop.slug}/${t.slug}.html`}
                  style={`display:block;padding:7px 10px;border-radius:8px;font-size:0.86rem;font-weight:${current ? '700' : '500'};background:${current ? 'var(--surface-mint)' : 'transparent'};color:${current ? 'var(--dark-green)' : 'var(--text-muted)'};`}
                >
                  {t.order}. {t.title}
                </a>
              </li>
            );
          })}
        </ul>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  @media (max-width: 900px) {
    .section-white .container {
      grid-template-columns: 1fr !important;
    }
    aside {
      position: static !important;
    }
  }
</style>
